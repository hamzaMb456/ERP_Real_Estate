# Copy to .env.local. Values are public (sent to the browser); never put an admin secret here.

# Public front office (the one organization the site serves, and the agency contact details)
NEXT_PUBLIC_AGENCY_ORG_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AGENCY_PHONE=+216 71 000 000
NEXT_PUBLIC_AGENCY_EMAIL=contact@emerald-immobilier.tn
NEXT_PUBLIC_AGENCY_ADDRESS=Rue du Lac Biwa, Les Berges du Lac, Tunis

# File storage (property/lease files) â€” server-only, never NEXT_PUBLIC_. Points at Floci locally.
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
